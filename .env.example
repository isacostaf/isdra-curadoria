# Copie este arquivo para ".env" (na raiz do projeto) e preencha com os
# valores reais. O ".env" nunca deve ser commitado — já está no .gitignore.

# Project Settings > API, no painel do Supabase
SUPABASE_URL=

# Project Settings > API > service_role (secreta — NUNCA use a "anon" key
# aqui, e nunca exponha esse valor no frontend ou em commits)
SUPABASE_SERVICE_ROLE_KEY=

# Uma string aleatória qualquer, só pra assinar os tokens de sessão.
# Gere uma com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Porta local (opcional, padrão 3210)
PORT=3210
